# Copy to .env next to docker-compose-prod.yml and set real values; .env is not committed.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
ORDER_DB_PASSWORD=change-me-three
IDENTITY_DB_PASSWORD=change-me-four

# sign-in (identity-service): URLs as browsers open them
PUBLIC_URL=http://localhost:8080
IDENTITY_PUBLIC_URL=http://localhost:8086
# OAuth2 client secrets: the gateway (staff sign-in) and order-service (calls to Inventory)
GATEWAY_CLIENT_SECRET=change-me-five
ORDER_CLIENT_SECRET=change-me-six
# first platform admin; change the password after the first sign-in
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-seven

# published ports (optional)
GATEWAY_PORT=8765
ADMIN_UI_PORT=8080
IDENTITY_PORT=8086
