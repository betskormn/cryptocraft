# Production image: static build served by nginx, which also proxies the API and price sockets
# to the gateway (same origin, so no CORS). The dev image (Dockerfile) runs the Vite dev server.
FROM node:24.13-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
